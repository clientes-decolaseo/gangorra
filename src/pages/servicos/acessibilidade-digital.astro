---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  buildBreadcrumbJsonLd,
  buildFaqJsonLd,
  ORG_ID,
  SITE_URL,
} from '../../lib/seo';
import { buildWhatsAppUrl } from '../../lib/nap';

const pagePath = '/servicos/acessibilidade-digital';
const pageUrl = `${SITE_URL}${pagePath}`;

const title = 'Acessibilidade Digital para Sites e Apps | Gangorra';
const description =
  'Consultoria em acessibilidade digital para conformidade com WCAG e eMAG. Auditoria, plano de adequação e validação por pessoas com deficiência. Todo o Brasil.';

const whatsappUrl = buildWhatsAppUrl(
  'Olá! Gostaria de um diagnóstico de acessibilidade digital para meu site ou app.',
);
const whatsappAriaLabel =
  'Solicitar diagnóstico de acessibilidade digital (abre em nova janela)';
const ctaLabel = 'Solicitar diagnóstico de acessibilidade';

const services = [
  'Auditoria de acessibilidade (diagnóstico segundo WCAG e eMAG)',
  'Plano de adequação priorizado por impacto no usuário',
  'Orientação técnica para a sua equipe de desenvolvimento',
  'Validação com usuários reais de tecnologia assistiva',
  'Documento de conformidade ao final do processo',
];

const howItWorks = [
  {
    title: 'Diagnóstico',
    text: 'avaliamos seu site ou app e identificamos as barreiras.',
  },
  {
    title: 'Plano de adequação',
    text: 'entregamos as recomendações priorizadas por impacto no usuário.',
  },
  {
    title: 'Orientação',
    text: 'apoiamos a sua equipe de desenvolvimento na implementação das correções.',
  },
  {
    title: 'Validação',
    text: 'testamos com pessoas com deficiência e confirmamos a conformidade.',
  },
];

const whyItMatters = [
  'Cumpre a legislação e reduz risco jurídico.',
  'Amplia seu público: milhões de pessoas com deficiência no Brasil.',
  'Melhora a experiência de uso para todos.',
  'Fortalece a reputação e o valor da sua marca.',
];

const faqs = [
  {
    question: 'O que é acessibilidade digital?',
    answer:
      'É a prática de tornar sites e aplicativos usáveis por todas as pessoas, incluindo quem tem deficiência visual, auditiva, motora ou cognitiva, seguindo as diretrizes WCAG.',
  },
  {
    question: 'Meu site precisa seguir a WCAG e o eMAG?',
    answer:
      'A WCAG é a referência internacional de acessibilidade web. Sites de órgãos públicos brasileiros também devem seguir o eMAG. Para empresas privadas, a adequação atende à Lei Brasileira de Inclusão e reduz risco jurídico.',
  },
  {
    question: 'A Gangorra corrige o código ou orienta a correção?',
    answer:
      'Atuamos como consultoria: entregamos o diagnóstico, o plano de adequação e a orientação técnica para a sua equipe implementar as correções, com validação ao final.',
  },
  {
    question: 'Qual a diferença entre teste automático e validação com usuários?',
    answer:
      'Ferramentas automáticas detectam parte das barreiras. A validação com pessoas com deficiência revela problemas reais de uso que nenhuma ferramenta identifica sozinha.',
  },
  {
    question: 'Recebo algum comprovante de conformidade?',
    answer:
      'Sim. Ao final do processo, entregamos um documento de conformidade do seu site ou aplicativo.',
  },
];

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: 'Início', path: '/' },
  { name: 'Serviços', path: '/servicos' },
  { name: 'Acessibilidade digital para sites e aplicativos', path: pagePath },
]);

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Consultoria em acessibilidade digital para sites e aplicativos',
  provider: { '@id': ORG_ID },
  areaServed: 'BR',
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: pageUrl,
  },
  description:
    'Consultoria em acessibilidade digital para sites e aplicativos, conforme WCAG e eMAG, com auditoria, plano de adequação, orientação técnica, validação por usuários reais de tecnologia assistiva e documento de conformidade. Atendimento remoto em todo o Brasil.',
};

const faqJsonLd = buildFaqJsonLd(faqs);

const otherServices = (await getCollection('servicesDetail'))
  .filter((item) => item.data.slug !== 'acessibilidade-digital')
  .sort((a, b) => a.data.shortTitle.localeCompare(b.data.shortTitle, 'pt-BR'));
---

<BaseLayout
  title={title}
  description={description}
  canonical={pagePath}
  jsonLd={[breadcrumbJsonLd, serviceJsonLd, faqJsonLd]}
>
  <section class="gradient-hero py-12 md:py-16" aria-labelledby="servico-title">
    <div class="container-page">
      <nav class="text-sm text-ink-soft" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1">
          <li><a href="/" class="hover:text-primary">Início</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/servicos" class="hover:text-primary">Serviços</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink" aria-current="page">
            Acessibilidade digital para sites e aplicativos
          </li>
        </ol>
      </nav>

      <p class="eyebrow mt-6">Serviço</p>
      <h1
        id="servico-title"
        class="mt-3 max-w-3xl font-display text-3xl font-semibold leading-tight text-ink md:text-4xl"
      >
        Acessibilidade digital para sites e aplicativos
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft md:text-lg">
        Torne seu site ou aplicativo acessível a todas as pessoas. Consultoria especializada, com
        validação de quem realmente usa tecnologia assistiva.
      </p>

      <div class="mt-8">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold transition-opacity"
          aria-label={whatsappAriaLabel}
        >
          {ctaLabel}
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20" aria-labelledby="o-que-e-title">
    <div class="container-page max-w-3xl">
      <h2 id="o-que-e-title" class="font-display text-xl font-semibold text-ink md:text-2xl">
        O que é acessibilidade digital
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft md:text-base">
        Acessibilidade digital garante que qualquer pessoa possa usar seu site ou app. Isso inclui
        pessoas cegas, com baixa visão, surdas ou com deficiência motora. Na prática, é adequar o
        produto às diretrizes internacionais de acessibilidade (WCAG) e, no caso de sites públicos,
        ao eMAG, o padrão do governo brasileiro. O resultado é um produto usável por todos e
        alinhado à Lei Brasileira de Inclusão (Lei nº 13.146/2015).
      </p>
    </div>
  </section>

  <section
    class="border-t border-border bg-surface-muted py-14 md:py-20"
    aria-labelledby="servicos-digital-title"
  >
    <div class="container-page max-w-3xl">
      <h2 id="servicos-digital-title" class="font-display text-2xl font-semibold text-ink md:text-3xl">
        Nossa consultoria de acessibilidade digital
      </h2>
      <ul class="mt-6 flex flex-col gap-3">
        {
          services.map((item) => (
            <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-soft md:text-base">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="py-14 md:py-20" aria-labelledby="como-funciona-title">
    <div class="container-page">
      <h2 id="como-funciona-title" class="font-display text-2xl font-semibold text-ink md:text-3xl">
        Como funciona
      </h2>
      <ol class="mt-8 grid gap-4">
        {
          howItWorks.map((step, index) => (
            <li class="card-elevated flex gap-4 p-5">
              <span class="mt-0.5 shrink-0 text-primary" aria-hidden="true">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-primary">
                  Passo {index + 1} — {step.title}
                </p>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft md:text-base">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section
    class="border-t border-border bg-surface-muted py-14 md:py-20"
    aria-labelledby="diferencial-title"
  >
    <div class="container-page max-w-3xl">
      <h2 id="diferencial-title" class="font-display text-2xl font-semibold text-ink md:text-3xl">
        Validado por quem vive a acessibilidade
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft md:text-base">
        Ferramentas automáticas encontram parte dos problemas. A experiência real encontra o resto.
        Nossa validação envolve pessoas com deficiência usando o produto. Esse é o padrão que separa
        um site tecnicamente correto de um site verdadeiramente acessível.
      </p>
    </div>
  </section>

  <section class="py-14 md:py-20" aria-labelledby="por-que-importa-title">
    <div class="container-page max-w-3xl">
      <h2 id="por-que-importa-title" class="font-display text-2xl font-semibold text-ink md:text-3xl">
        Por que investir em acessibilidade digital
      </h2>
      <ul class="mt-6 flex flex-col gap-3">
        {
          whyItMatters.map((item) => (
            <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-soft md:text-base">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section
    class="border-t border-border bg-surface-muted py-14 md:py-20"
    aria-labelledby="atendimento-title"
  >
    <div class="container-page max-w-3xl">
      <h2 id="atendimento-title" class="font-display text-2xl font-semibold text-ink md:text-3xl">
        Atendemos todo o Brasil
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft md:text-base">
        Consultoria 100% remota, para empresas e instituições de qualquer lugar do país. Nossa base é
        em Poá/SP.
      </p>
    </div>
  </section>

  <section class="py-14 md:py-20" aria-labelledby="faq-title">
    <div class="container-page max-w-3xl">
      <h2 id="faq-title" class="font-display text-2xl font-semibold text-ink md:text-3xl">
        Perguntas frequentes
      </h2>
      <div class="mt-8 flex flex-col gap-3">
        {
          faqs.map((faq) => (
            <details class="card-elevated group">
              <summary class="cursor-pointer list-none p-5 font-semibold text-ink marker:content-none [&::-webkit-details-marker]:hidden">
                <span class="flex items-center justify-between gap-4">
                  {faq.question}
                  <svg
                    class="shrink-0 text-primary transition-transform group-open:rotate-180"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </span>
              </summary>
              <div class="border-t border-border px-5 pb-5 pt-4 text-sm leading-relaxed text-ink-soft">
                {faq.answer}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="border-t border-border bg-surface-muted py-14 md:py-20"
    aria-labelledby="cta-servico-title"
  >
    <div class="container-page">
      <div class="rounded-3xl border border-border bg-surface px-6 py-10 text-center md:px-12 md:py-14">
        <h2 id="cta-servico-title" class="font-display text-2xl font-semibold text-ink md:text-3xl">
          Vamos tornar seu produto acessível?
        </h2>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp mt-8 inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold transition-opacity"
          aria-label={whatsappAriaLabel}
        >
          {ctaLabel}
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-border pb-16 md:pb-24" aria-labelledby="outros-servicos-title">
    <div class="container-page">
      <h2 id="outros-servicos-title" class="font-display text-2xl font-semibold text-ink md:text-3xl">
        Outros serviços
      </h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-3">
        {
          otherServices.map((other) => (
            <li>
              <a
                href={`/servicos/${other.data.slug}`}
                class="card-elevated group flex h-full flex-col gap-3 p-5 transition-shadow hover:shadow-[var(--shadow-glow)]"
              >
                <h3 class="text-base font-semibold text-ink group-hover:text-primary">
                  {other.data.shortTitle}
                </h3>
                <p class="text-sm leading-relaxed text-ink-soft">{other.data.lede}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
