---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<section class="py-14 md:py-20" aria-labelledby="portfolio-title">
  <div class="container-page">
    <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow">Portfólio</p>
        <h2 id="portfolio-title" class="mt-2 font-display text-2xl font-semibold text-ink md:text-3xl">
          Projetos recentes
        </h2>
      </div>
      <a
        href="/portfolio"
        class="text-sm font-semibold text-primary transition-colors hover:text-ink"
      >
        Ver portfólio completo →
      </a>
    </div>

    <div class="snap-carousel" role="list" aria-label="Carrossel de projetos do portfólio">
      {
        projects.map((project) => (
          <article
            id={`projeto-${project.data.slug}`}
            class="card-elevated snap-carousel__item snap-carousel__item--portfolio overflow-hidden"
            role="listitem"
          >
            <div class="flex aspect-[4/3] items-center justify-center bg-black">
              <Image
                src={project.data.image}
                alt={project.data.alt}
                width={project.data.image.width}
                height={project.data.image.height}
                format="webp"
                quality="mid"
                loading="lazy"
                class="h-full w-full object-contain"
              />
            </div>
            <div class="flex flex-col gap-2 p-4">
              <p class="text-xs font-medium uppercase tracking-wide text-primary">
                {project.data.category}
              </p>
              <h3 class="text-base font-semibold text-ink">{project.data.title}</h3>
              <p class="line-clamp-3 text-sm leading-relaxed text-ink-soft">
                {project.data.description}
              </p>
              {
                project.data.link && (
                  <a
                    href={project.data.link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-1 text-sm font-semibold text-primary hover:underline"
                    aria-label={`${project.data.link.label} — ${project.data.title} (abre em nova janela)`}
                  >
                    {project.data.link.label}
                  </a>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
