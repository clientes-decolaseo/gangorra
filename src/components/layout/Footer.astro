---
import { Image } from 'astro:assets';
import { NAP } from '../../lib/nap';

// TODO: substituir por logo-gangorra.png definitivo quando o asset final estiver disponível
import logo from '../../assets/logo-gangorra.png';

const footerNav = [
  { href: '/sobre', label: 'Sobre nós' },
  { href: '/servicos', label: 'Serviços' },
  { href: '/portfolio', label: 'Portfólio' },
  { href: '/blog', label: 'Blog' },
  { href: '/contato', label: 'Contato' },
] as const;

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface-muted">
  <div class="container-page py-12 md:py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-3">
      <div class="flex flex-col gap-6">
        <a href="/" class="inline-block w-fit shrink-0 self-start" aria-label="Gangorra Audiodescrição — página inicial">
          <Image
            src={logo}
            alt="Gangorra Audiodescrição"
            width={250}
            height={88}
            format="webp"
            quality="mid"
            class="h-40 w-auto"
          />
        </a>
        <p class="max-w-sm text-sm leading-relaxed text-ink-soft">
          Audiodescrição e acessibilidade cultural e digital para tornar conteúdos
          visuais acessíveis a todas as pessoas.
        </p>
      </div>

      <nav aria-label="Navegação do rodapé">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-widest text-ink">
          Navegação
        </h2>
        <ul class="flex flex-col gap-2">
          {
            footerNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-ink-soft transition-colors hover:text-primary"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-widest text-ink">
          Contato
        </h2>
        <address class="flex flex-col gap-4 not-italic">
          <p class="flex items-start gap-3 text-sm text-ink-soft">
            <svg class="mt-0.5 shrink-0 text-primary" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            <span>
              {NAP.streetAddress}
              <br />
              {NAP.locality} — {NAP.region}, {NAP.postalCode}
            </span>
          </p>

          <p class="flex items-center gap-3 text-sm">
            <svg class="shrink-0 text-primary" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" />
            </svg>
            <a href={`tel:${NAP.phoneE164}`} class="text-ink-soft transition-colors hover:text-primary">
              {NAP.phoneDisplay}
            </a>
          </p>

          <p class="flex items-center gap-3 text-sm">
            <svg class="shrink-0 text-primary" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" />
              <rect x="2" y="4" width="20" height="16" rx="2" />
            </svg>
            <a href={`mailto:${NAP.email}`} class="text-ink-soft transition-colors hover:text-primary">
              {NAP.email}
            </a>
          </p>
        </address>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-border pt-8 text-sm text-ink-soft">
      <p>&copy; {year} {NAP.name}. Todos os direitos reservados.</p>
      <p>Site desenvolvido com acessibilidade real — WCAG 2.2 AA.</p>
    </div>
  </div>
</footer>
