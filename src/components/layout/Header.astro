---
import { Image } from 'astro:assets';
import { WHATSAPP_DEFAULT_URL } from '../../lib/nap';

// TODO: substituir por logo-gangorra.png definitivo quando o asset final estiver disponível
import logo from '../../assets/logo-gangorra.png';

const navItems = [
  { href: '/', label: 'Início' },
  { href: '/sobre', label: 'Sobre' },
  { href: '/servicos', label: 'Serviços' },
  { href: '/portfolio', label: 'Portfólio' },
  { href: '/blog', label: 'Blog' },
  { href: '/contato', label: 'Contato' },
] as const;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

function isCurrent(href: string): boolean {
  const target = href.replace(/\/$/, '') || '/';
  if (target === '/') return pathname === '/';
  return pathname === target || pathname.startsWith(`${target}/`);
}
---

<header class="site-header">
  <input
    type="checkbox"
    id="nav-toggle"
    class="nav-toggle sr-only"
    aria-label="Abrir menu de navegação"
  />

  <div class="container-page flex h-16 items-center justify-between gap-4 md:h-20">
    <a href="/" class="shrink-0" aria-label="Gangorra Audiodescrição — página inicial">
      <Image
        src={logo}
        alt="Gangorra Audiodescrição"
        width={1179}
        height={912}
        format="webp"
        quality="mid"
        class="h-10 w-auto md:h-12"
      />
    </a>

    <label for="nav-toggle" class="nav-toggle-label md:hidden" aria-hidden="true">
      <svg class="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" x2="20" y1="6" y2="6" />
        <line x1="4" x2="20" y1="12" y2="12" />
        <line x1="4" x2="20" y1="18" y2="18" />
      </svg>
      <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18" />
        <path d="m6 6 12 12" />
      </svg>
    </label>

    <nav class="desktop-nav hidden items-center gap-1 md:flex" aria-label="Navegação principal">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              isCurrent(item.href)
                ? 'bg-primary-soft text-primary'
                : 'text-ink-soft hover:bg-surface-muted hover:text-ink',
            ]}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={WHATSAPP_DEFAULT_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-whatsapp hidden shrink-0 items-center gap-2 rounded-full px-4 py-2.5 text-sm font-semibold transition-opacity hover:opacity-90 md:inline-flex"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
      </svg>
      Falar no WhatsApp
    </a>
  </div>

  <nav id="nav-menu" class="mobile-nav" aria-label="Navegação mobile">
    <div class="container-page flex flex-col gap-1 py-4">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-lg px-3 py-3 text-base font-medium transition-colors',
              isCurrent(item.href)
                ? 'bg-primary-soft text-primary'
                : 'text-ink-soft hover:bg-surface-muted hover:text-ink',
            ]}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={WHATSAPP_DEFAULT_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-whatsapp mt-2 inline-flex items-center justify-center gap-2 rounded-full px-4 py-3 text-sm font-semibold transition-opacity hover:opacity-90"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
        </svg>
        Falar no WhatsApp
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background-color: oklch(0.995 0.004 240 / 0.92);
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow-soft);
  }

  .nav-toggle-label {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-width: 2.75rem;
    min-height: 2.75rem;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.625rem;
    border-radius: 0.75rem;
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .nav-toggle-label:hover {
    background-color: var(--color-surface-muted);
  }

  .icon-close {
    display: none;
  }

  .mobile-nav {
    display: none;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  #nav-toggle:checked ~ .mobile-nav {
    display: block;
  }

  #nav-toggle:checked ~ .container-page .nav-toggle-label .icon-open {
    display: none;
  }

  #nav-toggle:checked ~ .container-page .nav-toggle-label .icon-close {
    display: block;
  }

  #nav-toggle:focus-visible ~ .container-page .nav-toggle-label {
    outline: 3px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
