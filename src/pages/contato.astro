---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildBreadcrumbJsonLd } from '../lib/seo';
import { NAP, WHATSAPP_DEFAULT_URL } from '../lib/nap';

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: 'Início', path: '/' },
  { name: 'Contato', path: '/contato' },
]);

const mapQuery = `${NAP.streetAddress}, ${NAP.locality}, ${NAP.region}, ${NAP.postalCode}, Brasil`;
const mapEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`;
const mapLinkUrl = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}`;

const mailtoSubject = encodeURIComponent('Contato pelo site Gangorra Audiodescrição');
const mailtoBody = encodeURIComponent(
  'Olá! Gostaria de conversar sobre um projeto de audiodescrição ou acessibilidade.\n\nNome:\nTelefone:\nEmpresa:\nMensagem:\n',
);
const mailtoUrl = `mailto:${NAP.email}?subject=${mailtoSubject}&body=${mailtoBody}`;

const inputClass =
  'w-full rounded-lg border border-border bg-surface px-4 py-3 text-sm text-ink transition-colors placeholder:text-ink-soft/60 focus-visible:border-primary focus-visible:ring-2 focus-visible:ring-primary/20';
---

<BaseLayout
  title="Contato — Fale com a Gangorra Audiodescrição"
  description="Fale com a Gangorra Audiodescrição por formulário, e-mail, WhatsApp ou telefone. Atendimento humano e técnico para o seu projeto acessível."
  canonical="/contato"
  jsonLd={[breadcrumbJsonLd]}
>
  <section class="gradient-hero py-12 md:py-16" aria-labelledby="contato-hero-title">
    <div class="container-page max-w-3xl">
      <p class="eyebrow">Contato</p>
      <h1
        id="contato-hero-title"
        class="mt-3 font-display text-3xl font-semibold text-ink md:text-4xl"
      >
        Fale com a <span class="text-gradient">Gangorra</span>
      </h1>
      <p class="mt-4 text-base leading-relaxed text-ink-soft md:text-lg">
        Envie sua mensagem diretamente para o nosso e-mail. Respondemos em até 1 dia útil.
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16" aria-labelledby="formulario-title">
    <div class="container-page">
      <!--
        TODO: definir action com o endpoint do provedor de formulário
        (Web3Forms, Formspree, etc.) — form não funcional até definir
      -->
      <div class="card-elevated mx-auto max-w-2xl p-6 md:p-8 lg:p-10">
        <h2 id="formulario-title" class="font-display text-xl font-semibold text-ink md:text-2xl">
          Enviar mensagem
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft md:text-base">
          Sua mensagem é registrada com segurança e respondida em até 1 dia útil.
        </p>

        <form
          method="POST"
          action="#"
          class="mt-8 flex flex-col gap-5"
          aria-describedby="formulario-title"
        >
          <!-- Campos hidden que provavelmente serão necessários (ajustar conforme o provedor escolhido): -->
          <!-- Web3Forms: <input type="hidden" name="access_key" value="TODO"> -->
          <!-- Formspree: action muda para https://formspree.io/f/SEU_ID, sem hidden -->
          <input
            type="hidden"
            name="subject"
            value="Contato pelo site Gangorra Audiodescrição"
          />
          <input
            type="text"
            name="_gotcha"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div>
            <label for="contato-nome" class="mb-1.5 block text-sm font-medium text-ink">
              Nome <span class="text-destructive" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="contato-nome"
              name="nome"
              required
              autocomplete="name"
              class={inputClass}
            />
          </div>

          <div>
            <label for="contato-email" class="mb-1.5 block text-sm font-medium text-ink">
              E-mail <span class="text-destructive" aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="contato-email"
              name="email"
              required
              autocomplete="email"
              inputmode="email"
              class={inputClass}
            />
          </div>

          <div>
            <label for="contato-telefone" class="mb-1.5 block text-sm font-medium text-ink">
              Telefone <span class="text-destructive" aria-hidden="true">*</span>
            </label>
            <input
              type="tel"
              id="contato-telefone"
              name="telefone"
              required
              autocomplete="tel"
              inputmode="tel"
              class={inputClass}
            />
          </div>

          <div>
            <label for="contato-empresa" class="mb-1.5 block text-sm font-medium text-ink">
              Empresa
            </label>
            <input
              type="text"
              id="contato-empresa"
              name="empresa"
              autocomplete="organization"
              class={inputClass}
            />
          </div>

          <div>
            <label for="contato-mensagem" class="mb-1.5 block text-sm font-medium text-ink">
              Mensagem <span class="text-destructive" aria-hidden="true">*</span>
            </label>
            <textarea
              id="contato-mensagem"
              name="mensagem"
              rows="5"
              required
              maxlength="5000"
              class={`${inputClass} resize-y`}
            ></textarea>
          </div>

          <button
            type="submit"
            class="mt-2 inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90"
          >
            Enviar mensagem
          </button>
        </form>
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-surface-muted py-12 md:py-16" aria-labelledby="canais-title">
    <div class="container-page">
      <h2 id="canais-title" class="sr-only">Canais diretos de contato</h2>
      <ul class="grid gap-4 md:grid-cols-3">
        <li>
          <a
            href={mailtoUrl}
            class="card-elevated flex h-full flex-col gap-4 p-5 transition-colors hover:border-primary/30"
          >
            <svg
              class="text-primary"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" />
              <rect x="2" y="4" width="20" height="16" rx="2" />
            </svg>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-ink-soft">E-mail</p>
              <p class="mt-1 text-sm font-medium text-ink break-all">{NAP.email}</p>
            </div>
          </a>
        </li>

        <li>
          <a
            href={WHATSAPP_DEFAULT_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="card-elevated flex h-full flex-col gap-4 p-5 transition-colors hover:border-primary/30"
            aria-label="Falar no WhatsApp (abre em nova janela)"
          >
            <svg
              class="text-primary"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
            </svg>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-ink-soft">WhatsApp</p>
              <p class="mt-1 text-sm font-medium text-ink">{NAP.phoneDisplay}</p>
            </div>
          </a>
        </li>

        <li>
          <a
            href={`tel:${NAP.phoneE164}`}
            class="card-elevated flex h-full flex-col gap-4 p-5 transition-colors hover:border-primary/30"
          >
            <svg
              class="text-primary"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" />
            </svg>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-ink-soft">Telefone</p>
              <p class="mt-1 text-sm font-medium text-ink">{NAP.phoneDisplay}</p>
            </div>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="border-t border-border py-14 md:py-20" aria-labelledby="onde-estamos-title">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-12">
        <div>
          <h2 id="onde-estamos-title" class="font-display text-2xl font-semibold text-ink md:text-3xl">
            Onde estamos
          </h2>
          <p class="mt-4 text-base leading-relaxed text-ink-soft">
            Sede em Poá/SP. Atendemos São Paulo, região metropolitana e todo o Brasil.
          </p>

          <div class="mt-6 rounded-2xl border border-border bg-primary-soft p-5 md:p-6">
            <address class="flex flex-col gap-4 not-italic">
              <p class="flex items-start gap-3 text-sm text-ink-soft">
                <svg
                  class="mt-0.5 shrink-0 text-primary"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                <span>
                  {NAP.streetAddress}
                  <br />
                  {NAP.locality} — {NAP.region}, {NAP.postalCode}
                </span>
              </p>

              <a
                href={`tel:${NAP.phoneE164}`}
                class="flex min-h-11 items-center gap-3 py-2 text-sm text-ink-soft transition-colors hover:text-primary"
              >
                <svg
                  class="shrink-0 text-primary"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" />
                </svg>
                <span>{NAP.phoneDisplay}</span>
              </a>

              <a
                href={`mailto:${NAP.email}`}
                class="flex min-h-11 items-center gap-3 py-2 text-sm text-ink-soft transition-colors hover:text-primary"
              >
                <svg
                  class="shrink-0 text-primary"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" />
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                </svg>
                <span class="break-all">{NAP.email}</span>
              </a>
            </address>
          </div>

          <a
            href={NAP.googleBusinessProfile}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center justify-center rounded-full border border-border bg-surface px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-surface-muted"
            aria-label="Ver no Google (abre em nova janela)"
          >
            Ver no Google
          </a>
        </div>

        <div>
          <div class="overflow-hidden rounded-2xl border border-border shadow-[var(--shadow-soft)]">
            <iframe
              src={mapEmbedUrl}
              width="100%"
              height="320"
              class="map-embed block w-full border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Mapa com a localização da Gangorra Audiodescrição em Poá, SP"
            ></iframe>
          </div>
          <p class="mt-4 text-center text-sm">
            <a
              href={mapLinkUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center py-2 font-medium text-primary transition-colors hover:underline"
            >
              Abrir no Google Maps
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @media (min-width: 768px) {
    .map-embed {
      height: 380px;
    }
  }
</style>
