---
import type { CollectionEntry } from 'astro:content';

interface Props {
  testimonials: CollectionEntry<'testimonials'>[];
}

const { testimonials } = Astro.props;

const googleReviewsUrl =
  'https://www.google.com/search?q=Gangorra+Audiodescri%C3%A7%C3%A3o+Coment%C3%A1rios';
---

<section class="py-14 md:py-20" aria-labelledby="depoimentos-title">
  <div class="container-page">
    <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="eyebrow">Depoimentos</p>
        <h2 id="depoimentos-title" class="mt-2 font-display text-2xl font-semibold text-ink md:text-3xl">
          Avaliações no Google
        </h2>
        <div class="mt-3 flex flex-wrap items-center gap-2 text-sm text-ink-soft">
          <span class="inline-flex text-amber-500" aria-hidden="true">
            {
              Array.from({ length: 5 }).map(() => (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
              ))
            }
          </span>
          <span>5,0 · avaliações verificadas no Google</span>
        </div>
      </div>
      <a
        href={googleReviewsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-semibold text-primary transition-colors hover:text-ink"
        aria-label="Ver todas as avaliações no Google (abre em nova janela)"
      >
        Ver todas no Google →
      </a>
    </div>

    <div class="snap-carousel" role="list" aria-label="Carrossel de depoimentos">
      {
        testimonials.map((testimonial) => (
          <article
            class="card-elevated snap-carousel__item snap-carousel__item--testimonial flex flex-col gap-4 p-5"
            role="listitem"
          >
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="text-primary/30"
              aria-hidden="true"
            >
              <path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-7 0c0-.476.096-.93.27-1.345m12.876 0c-1.03-1.094-1.583-2.321-1.583-4.31 0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-7 0c0-.476.096-.93.27-1.345" />
            </svg>

            <div
              class="inline-flex text-amber-500"
              role="img"
              aria-label={`Nota ${testimonial.data.rating} de 5 estrelas`}
            >
              {
                Array.from({ length: testimonial.data.rating }).map(() => (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                ))
              }
            </div>

            <blockquote class="flex-1 text-sm leading-relaxed text-ink-soft">
              <p>&ldquo;{testimonial.data.text}&rdquo;</p>
            </blockquote>

            <footer>
              <cite class="not-italic">
                <span class="block text-sm font-semibold text-ink">{testimonial.data.name}</span>
                {
                  testimonial.data.context && (
                    <span class="text-xs text-ink-soft">{testimonial.data.context}</span>
                  )
                }
              </cite>
            </footer>
          </article>
        ))
      }
    </div>
  </div>
</section>
