---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildBreadcrumbJsonLd, buildPeopleJsonLd } from '../lib/seo';

const team = (await getCollection('team')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'pt-BR'),
);

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: 'Início', path: '/' },
  { name: 'Sobre', path: '/sobre' },
]);

const peopleJsonLd = buildPeopleJsonLd(
  team.map((member) => ({
    slug: member.data.slug,
    name: member.data.name,
    jobTitle: member.data.jobTitle,
    description: member.data.description,
    alumniOf: member.data.alumniOf,
    knowsAbout: member.data.knowsAbout,
  })),
);
---

<BaseLayout
  title="Sobre a Gangorra — Propósito, Equipe e História"
  description="Conheça a história, o propósito e a equipe da Gangorra Audiodescrição, produtora referência em acessibilidade cultural e digital há mais de uma década."
  canonical="/sobre"
  jsonLd={[breadcrumbJsonLd, peopleJsonLd]}
>
  <section class="gradient-hero py-12 md:py-16" aria-labelledby="sobre-hero-title">
    <div class="container-page">
      <p class="eyebrow">Sobre nós</p>
      <h1
        id="sobre-hero-title"
        class="mt-3 font-display text-3xl font-semibold text-ink md:text-4xl"
      >
        Gangorra <span class="text-gradient">Audiodescrição</span>
      </h1>
    </div>
  </section>

  <section class="py-12 md:py-16" aria-labelledby="sobre-institutional-title">
    <div class="container-page max-w-3xl">
      <h2 id="sobre-institutional-title" class="sr-only">Nossa história</h2>
      <p class="text-base leading-relaxed text-ink-soft md:text-lg">
        A Gangorra Audiodescrição é produtora referência em audiodescrição e
        acessibilidade cultural e digital há mais de uma década. Atuamos a
        partir de Poá/SP para São Paulo, todo o estado e o Brasil, tornando
        teatro, eventos, conteúdos digitais e materiais institucionais
        acessíveis a todas as pessoas — com equipe formada por profissionais
        que vivem e praticam acessibilidade no dia a dia.
      </p>
    </div>
  </section>

  <section class="border-t border-border py-14 md:py-20" aria-labelledby="equipe-title">
    <div class="container-page">
      <p class="eyebrow">Equipe</p>
      <h2 id="equipe-title" class="mt-2 font-display text-2xl font-semibold text-ink md:text-3xl">
        Quem faz a Gangorra
      </h2>

      <ul class="mt-10 grid gap-10 md:grid-cols-2 md:gap-12">
        {
          team.map((member) => (
            <li>
              <article id={member.data.slug} class="flex flex-col gap-5">
                <Image
                  src={member.data.photo}
                  alt={member.data.photoAlt}
                  width={320}
                  height={400}
                  format="webp"
                  quality="mid"
                  loading="lazy"
                  class="aspect-[4/5] w-full max-w-xs rounded-2xl object-cover"
                />
                <div>
                  <h3 class="text-xl font-semibold text-ink">{member.data.name}</h3>
                  <p class="mt-1 text-sm font-medium text-primary">{member.data.jobTitle}</p>
                </div>
                <p class="text-sm leading-relaxed text-ink-soft md:text-base">
                  {member.data.description}
                </p>
                <ul class="flex flex-col gap-2">
                  {
                    member.data.credentials.map((credential) => (
                      <li class="flex items-start gap-2 text-sm text-ink-soft">
                        <svg
                          class="mt-0.5 shrink-0 text-primary"
                          width="18"
                          height="18"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M20 6 9 17l-5-5" />
                        </svg>
                        {credential}
                      </li>
                    ))
                  }
                </ul>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
