---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  buildBreadcrumbJsonLd,
  buildServicesListJsonLd,
} from '../../lib/seo';
import { WHATSAPP_DEFAULT_URL } from '../../lib/nap';
import ProofStrip from '../../components/sections/ProofStrip.astro';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);

const serviceDetails = (await getCollection('servicesDetail')).sort((a, b) =>
  a.data.shortTitle.localeCompare(b.data.shortTitle, 'pt-BR'),
);

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: 'Início', path: '/' },
  { name: 'Serviços', path: '/servicos' },
]);

const servicesListJsonLd = buildServicesListJsonLd(
  services.map((service) => ({
    slug: service.data.slug,
    name: service.data.title,
    description: service.data.summary,
  })),
);
---

<BaseLayout
  title="Serviços de Audiodescrição e Acessibilidade | Gangorra"
  description="Audiodescrição para teatro, eventos e locação de equipamentos. Atendimento a partir de Poá/SP para São Paulo e todo o Brasil."
  canonical="/servicos"
  jsonLd={[breadcrumbJsonLd, servicesListJsonLd]}
>
  <section class="gradient-hero py-12 md:py-16" aria-labelledby="servicos-hero-title">
    <div class="container-page">
      <p class="eyebrow">Serviços</p>
      <h1
        id="servicos-hero-title"
        class="mt-3 font-display text-3xl font-semibold text-ink md:text-4xl"
      >
        <span class="text-gradient">Serviços</span>
      </h1>
    </div>
  </section>

  <section class="py-14 md:py-20" aria-labelledby="servicos-grid-title">
    <div class="container-page">
      <h2 id="servicos-grid-title" class="sr-only">Todos os serviços</h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service) => (
            <li>
              <article class="card-elevated flex h-full flex-col gap-4 p-5">
                <h3 class="text-lg font-semibold text-ink">{service.data.title}</h3>
                <p class="flex-1 text-sm leading-relaxed text-ink-soft">
                  {service.data.summary}
                </p>
                <a
                  href={WHATSAPP_DEFAULT_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-whatsapp inline-flex items-center justify-center rounded-full px-4 py-2.5 text-sm font-semibold transition-opacity"
                  aria-label={`Solicitar orçamento de ${service.data.title} (abre em nova janela)`}
                >
                  Solicitar orçamento
                </a>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-border bg-surface-muted py-14 md:py-20" aria-labelledby="paginas-detalhadas-title">
    <div class="container-page">
      <p class="eyebrow">Alta intenção comercial</p>
      <h2 id="paginas-detalhadas-title" class="mt-2 font-display text-2xl font-semibold text-ink md:text-3xl">
        Páginas detalhadas
      </h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {
          serviceDetails.map((detail) => (
            <li>
              <a
                href={`/servicos/${detail.data.slug}`}
                class="card-elevated group flex h-full flex-col gap-3 p-5 transition-shadow hover:shadow-[var(--shadow-glow)]"
              >
                <h3 class="text-lg font-semibold text-ink group-hover:text-primary">
                  {detail.data.shortTitle}
                </h3>
                <p class="text-sm leading-relaxed text-ink-soft">{detail.data.lede}</p>
                <span class="text-sm font-semibold text-primary">Ver detalhes →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ProofStrip />
</BaseLayout>
