---
import { Image } from 'astro:assets';
import { WHATSAPP_DEFAULT_URL } from '../../lib/nap';
import logo from '../../assets/logo-gangorra.png';
import heroImage from '../../assets/hero-home.png';
---

<section class="gradient-hero py-12 md:py-20" aria-labelledby="hero-title">
  <div class="container-page grid items-center gap-10 md:grid-cols-12 md:gap-12">
    <div class="md:col-span-7">
      <p
        class="inline-flex items-center gap-1.5 rounded-full bg-surface-muted px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-widest text-ink-soft"
      >
        <span aria-hidden="true">●</span> Gangorra Audiodescrição
      </p>
      <h1
        id="hero-title"
        class="mt-4 font-display text-3xl font-semibold leading-tight text-ink sm:text-4xl md:text-5xl"
      >
        Audiodescrição e <span class="text-gradient">Acessibilidade</span> Cultural e Digital
      </h1>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-soft md:text-lg">
        Produzimos audiodescrição, acessibilidade digital, Braille, audiobooks,
        consultoria e validação de acessibilidade.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={WHATSAPP_DEFAULT_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-semibold shadow-glow transition-opacity"
          aria-label="Solicitar orçamento de audiodescrição (abre em nova janela)"
        >
          Solicitar orçamento de audiodescrição
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/servicos"
          class="inline-flex items-center justify-center rounded-full border border-border bg-surface px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-surface-muted"
        >
          Conhecer serviços
        </a>
      </div>
      <p class="mt-5 text-sm text-ink-soft">Atendimento de Poá/SP para todo o Brasil.</p>
    </div>

    <div class="flex w-full flex-col items-center gap-6 md:col-span-5 md:items-end">
      <div class="w-full max-w-[250px] md:max-w-[280px]">
          <Image
            src={logo}
            alt="Gangorra Audiodescrição — logo"
            width={1179}
            height={912}
            format="webp"
            quality="mid"
            loading="lazy"
            decoding="async"
            class="h-auto w-full"
          />
      </div>

      <div class="w-full max-w-lg overflow-hidden rounded-3xl shadow-glow">
        <div class="aspect-video w-full">
          <Image
            src={heroImage}
            alt="Audiodescritora em cabine transmitindo narração ao vivo durante espetáculo de teatro, com plateia usando fones de ouvido"
            width={960}
            height={540}
            format="webp"
            quality="mid"
            loading="eager"
            decoding="async"
            fetchpriority="low"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>
