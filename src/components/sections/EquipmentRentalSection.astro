---
import { Image } from 'astro:assets';
import { buildWhatsAppUrl } from '../../lib/nap';
import locacaoImage from '../../assets/locacao-b20.jpg';

const whatsappUrl = buildWhatsAppUrl(
  'Olá, tudo bem? Estou no site da Gangorra e gostaria de orçamento de locação de equipamentos de audiodescrição.',
);

const features = [
  {
    title: 'Transmissão e recepção',
    description:
      'Sistema de áudio sem fio para o público com deficiência visual acompanhar a audiodescrição ao vivo.',
    icon: 'radio',
  },
  {
    title: 'Cabine de narração',
    description:
      'Estrutura acústica para o audiodescritor narrar com isolamento e qualidade no local do evento.',
    icon: 'headphones',
  },
  {
    title: 'Apoio técnico',
    description:
      'Equipe presente para montagem, operação e suporte durante toda a apresentação.',
    icon: 'wrench',
  },
] as const;
---

<section class="py-14 md:py-20" aria-labelledby="locacao-title">
  <div class="container-page grid items-center gap-10 md:grid-cols-12 md:gap-12">
    <div class="md:col-span-5">
      <div class="overflow-hidden rounded-3xl shadow-glow">
        <div class="aspect-video w-full">
          <Image
            src={locacaoImage}
            alt="Cabine de narração azul instalada em mezanino durante evento corporativo com palco e plateia ao fundo"
            width={960}
            height={540}
            format="webp"
            quality="mid"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>

    <div class="md:col-span-7">
      <p
        class="inline-flex items-center gap-1.5 rounded-full bg-surface-muted px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-widest text-ink-soft"
      >
        Locação de equipamentos
      </p>
      <h2
        id="locacao-title"
        class="mt-4 font-display text-2xl font-semibold leading-tight text-ink sm:text-3xl md:text-4xl"
      >
        Cabine, transmissão e apoio técnico.
      </h2>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-soft md:text-lg">
        Alugamos equipamentos para transmissão e recepção de audiodescrição em eventos — cabine de
        narração, transmissores e fones de recepção — com apoio técnico especializado da nossa
        equipe durante todo o evento.
      </p>

      <ul class="mt-8 flex flex-col gap-6">
        {
          features.map((feature) => (
            <li class="flex gap-4">
              <span
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary"
                aria-hidden="true"
              >
                {
                  feature.icon === 'radio' && (
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9" />
                      <path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5" />
                      <circle cx="12" cy="12" r="2" />
                      <path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5" />
                      <path d="M19.1 4.9C23 8.8 23 15.1 19.1 19" />
                    </svg>
                  )
                }
                {
                  feature.icon === 'headphones' && (
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3" />
                    </svg>
                  )
                }
                {
                  feature.icon === 'wrench' && (
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                    </svg>
                  )
                }
              </span>
              <div>
                <h3 class="font-display text-lg font-semibold text-ink">{feature.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-ink-soft md:text-base">
                  {feature.description}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="mt-8">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-semibold shadow-glow transition-opacity"
          aria-label="Solicitar orçamento de locação (abre em nova janela)"
        >
          Solicitar orçamento de locação
          <span aria-hidden="true">→</span>
        </a>
        <p class="mt-4 text-sm text-ink-soft">Atendimento de Poá/SP para todo o Brasil.</p>
      </div>
    </div>
  </div>
</section>
