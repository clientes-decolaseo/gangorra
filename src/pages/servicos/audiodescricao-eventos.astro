---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  buildBreadcrumbJsonLd,
  buildFaqJsonLd,
  ORG_ID,
  SITE_URL,
} from '../../lib/seo';

const pagePath = '/servicos/audiodescricao-eventos';
const pageUrl = `${SITE_URL}${pagePath}`;

const title = 'Audiodescrição para Eventos ao Vivo | Gangorra';
const description =
  'Torne seu evento acessível a pessoas com deficiência visual. Audiodescrição profissional ao vivo, presencial ou remota, em todo o Brasil. Solicite um orçamento.';

const whatsappUrl =
  'https://api.whatsapp.com/send?phone=5511965707386&text=Ol%C3%A1!%20Gostaria%20de%20um%20or%C3%A7amento%20de%20audiodescri%C3%A7%C3%A3o%20para%20um%20evento.';
const whatsappAriaLabel =
  'Solicitar orçamento de audiodescrição para eventos (abre em nova janela)';
const ctaLabel = 'Solicitar orçamento para meu evento';

const eventTypes = [
  'Shows, espetáculos e apresentações musicais',
  'Congressos, palestras e seminários',
  'Formaturas e cerimônias',
  'Lives e transmissões online',
  'Premiações e lançamentos de produto',
  'Ativações de marca e eventos corporativos',
];

const howItWorks = [
  {
    title: 'Planejamento',
    text: 'analisamos o formato, o roteiro e as necessidades do evento.',
  },
  {
    title: 'Produção',
    text: 'preparamos o roteiro de audiodescrição sob medida.',
  },
  {
    title: 'Execução ao vivo',
    text: 'narração profissional, presencial ou remota, com equipamentos de transmissão sob demanda [CONFIRMAR detalhes de equipamento].',
  },
];

const whyGangorra = [
  'Equipe especialista, com formação e vivência em acessibilidade.',
  'Validação por pessoas com deficiência [CONFIRMAR autorização para citar].',
  'Experiência com marcas e instituições de referência [CONFIRMAR conforme portfólio].',
  'Atendimento em todo o Brasil, presencial ou remoto.',
];

const faqs = [
  {
    question: 'O que é audiodescrição para eventos?',
    answer:
      'É a narração ao vivo de imagens, cenas e ações do evento, permitindo que pessoas com deficiência visual acompanhem tudo pelo áudio.',
  },
  {
    question: 'A audiodescrição pode ser feita em eventos online?',
    answer:
      'Sim. Atendemos eventos presenciais e transmissões online, com audiodescrição totalmente remota quando necessário.',
  },
  {
    question: 'Audiodescrição em eventos é obrigatória por lei?',
    answer:
      'A Lei Brasileira de Inclusão (Lei nº 13.146/2015) estabelece o direito à acessibilidade. A audiodescrição é o recurso que garante esse acesso a pessoas com deficiência visual em eventos e conteúdos audiovisuais.',
  },
  {
    question: 'Vocês atendem em todo o Brasil?',
    answer:
      'Sim. Nossa base é em Poá/SP e atendemos eventos presenciais em todo o país, além de eventos online de forma remota.',
  },
  {
    question: 'Como solicito um orçamento?',
    answer:
      'Fale com a nossa equipe pelo WhatsApp com a data, o formato e o local do evento. Retornamos com uma proposta sob medida.',
  },
];

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: 'Início', path: '/' },
  { name: 'Serviços', path: '/servicos' },
  { name: 'Audiodescrição para eventos ao vivo', path: pagePath },
]);

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Audiodescrição para eventos ao vivo',
  provider: { '@id': ORG_ID },
  areaServed: 'BR',
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: pageUrl,
  },
  description:
    'Audiodescrição profissional ao vivo para eventos presenciais e online, em todo o Brasil.',
};

const faqJsonLd = buildFaqJsonLd(faqs);

const otherServices = (await getCollection('servicesDetail'))
  .filter((item) => item.data.slug !== 'audiodescricao-eventos')
  .sort((a, b) => a.data.shortTitle.localeCompare(b.data.shortTitle, 'pt-BR'));
---

<BaseLayout
  title={title}
  description={description}
  canonical={pagePath}
  jsonLd={[breadcrumbJsonLd, serviceJsonLd, faqJsonLd]}
>
  <section class="gradient-hero py-12 md:py-16" aria-labelledby="servico-title">
    <div class="container-page">
      <nav class="text-sm text-ink-soft" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1">
          <li><a href="/" class="hover:text-primary">Início</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/servicos" class="hover:text-primary">Serviços</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink" aria-current="page">Audiodescrição para eventos ao vivo</li>
        </ol>
      </nav>

      <p class="eyebrow mt-6">Serviço</p>
      <h1
        id="servico-title"
        class="mt-3 max-w-3xl font-display text-3xl font-semibold leading-tight text-ink md:text-4xl"
      >
        Audiodescrição para eventos ao vivo
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft md:text-lg">
        Torne seu evento acessível a pessoas com deficiência visual. Narração profissional, ao
        vivo, em qualquer lugar do Brasil.
      </p>

      <div class="mt-8">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold transition-opacity"
          aria-label={whatsappAriaLabel}
        >
          {ctaLabel}
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20" aria-labelledby="o-que-e-title">
    <div class="container-page max-w-3xl">
      <h2 id="o-que-e-title" class="font-display text-xl font-semibold text-ink md:text-2xl">
        O que é audiodescrição para eventos
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft md:text-base">
        A audiodescrição transforma imagens em palavras. Um profissional narra cenas, expressões e
        ações em tempo real. Pessoas cegas ou com baixa visão acompanham tudo pelo áudio. Em
        eventos ao vivo, isso garante inclusão de verdade e apoia o cumprimento da Lei Brasileira
        de Inclusão (Lei nº 13.146/2015).
      </p>
    </div>
  </section>

  <section
    class="border-t border-border bg-surface-muted py-14 md:py-20"
    aria-labelledby="eventos-title"
  >
    <div class="container-page max-w-3xl">
      <h2 id="eventos-title" class="font-display text-2xl font-semibold text-ink md:text-3xl">
        Eventos que atendemos
      </h2>
      <ul class="mt-6 flex flex-col gap-3">
        {
          eventTypes.map((item) => (
            <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-soft md:text-base">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="py-14 md:py-20" aria-labelledby="como-funciona-title">
    <div class="container-page">
      <h2 id="como-funciona-title" class="font-display text-2xl font-semibold text-ink md:text-3xl">
        Como funciona
      </h2>
      <ol class="mt-8 grid gap-4">
        {
          howItWorks.map((step, index) => (
            <li class="card-elevated flex gap-4 p-5">
              <span class="mt-0.5 shrink-0 text-primary" aria-hidden="true">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-primary">
                  Passo {index + 1} — {step.title}
                </p>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft md:text-base">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section
    class="border-t border-border bg-surface-muted py-14 md:py-20"
    aria-labelledby="por-que-gangorra-title"
  >
    <div class="container-page max-w-3xl">
      <h2 id="por-que-gangorra-title" class="font-display text-2xl font-semibold text-ink md:text-3xl">
        Por que escolher a Gangorra
      </h2>
      <ul class="mt-6 flex flex-col gap-3">
        {
          whyGangorra.map((item) => (
            <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-soft md:text-base">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="py-14 md:py-20" aria-labelledby="atendimento-title">
    <div class="container-page max-w-3xl">
      <h2 id="atendimento-title" class="font-display text-2xl font-semibold text-ink md:text-3xl">
        Atendemos todo o Brasil
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft md:text-base">
        Da nossa base em Poá/SP para todo o país. Eventos presenciais sob agenda e eventos online
        com audiodescrição 100% remota.
      </p>
    </div>
  </section>

  <section
    class="border-t border-border bg-surface-muted py-14 md:py-20"
    aria-labelledby="faq-title"
  >
    <div class="container-page max-w-3xl">
      <h2 id="faq-title" class="font-display text-2xl font-semibold text-ink md:text-3xl">
        Perguntas frequentes
      </h2>
      <div class="mt-8 flex flex-col gap-3">
        {
          faqs.map((faq) => (
            <details class="card-elevated group">
              <summary class="cursor-pointer list-none p-5 font-semibold text-ink marker:content-none [&::-webkit-details-marker]:hidden">
                <span class="flex items-center justify-between gap-4">
                  {faq.question}
                  <svg
                    class="shrink-0 text-primary transition-transform group-open:rotate-180"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </span>
              </summary>
              <div class="border-t border-border px-5 pb-5 pt-4 text-sm leading-relaxed text-ink-soft">
                {faq.answer}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20" aria-labelledby="cta-servico-title">
    <div class="container-page">
      <div class="rounded-3xl border border-border bg-surface-muted px-6 py-10 text-center md:px-12 md:py-14">
        <h2 id="cta-servico-title" class="font-display text-2xl font-semibold text-ink md:text-3xl">
          Vamos tornar seu evento acessível?
        </h2>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp mt-8 inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold transition-opacity"
          aria-label={whatsappAriaLabel}
        >
          {ctaLabel}
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-border pb-16 md:pb-24" aria-labelledby="outros-servicos-title">
    <div class="container-page">
      <h2 id="outros-servicos-title" class="font-display text-2xl font-semibold text-ink md:text-3xl">
        Outros serviços
      </h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-3">
        {
          otherServices.map((other) => (
            <li>
              <a
                href={`/servicos/${other.data.slug}`}
                class="card-elevated group flex h-full flex-col gap-3 p-5 transition-shadow hover:shadow-[var(--shadow-glow)]"
              >
                <h3 class="text-base font-semibold text-ink group-hover:text-primary">
                  {other.data.shortTitle}
                </h3>
                <p class="text-sm leading-relaxed text-ink-soft">{other.data.lede}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
